<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Main" Id="{c25bff15-c608-4598-82ae-e72b24ab7da1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // Communicatie tussen tasks
    coffeeReady : BOOL := FALSE;       // Wordt TRUE zodra koffie klaar is
    travelFinished : BOOL := FALSE;    // Wordt TRUE zodra je op school bent

    // Statussen
    travelState : INT := 0;            // Huidige stap in de reis
    coffeeState : INT := 0;            // Huidige stap in het koffietraject

    // Variabelen voor functie
    distanceToSchool : INT := 15;      // km
    avgSpeed : INT := 15;              // km/h
    travelTime : INT := 0;             // minuten, output van functie
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>